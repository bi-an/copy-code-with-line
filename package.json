{
  "name": "copy-code-with-line",
  "displayName": "Copy Code With Line",
  "publisher": "Iqbalalhr",
  "version": "1.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/Iqbalalh/copy-code-with-line.git"
  },
  "description": "Copy Code with Line Numbers",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Copy Code With Line",
      "properties": {
        "copyCodeWithLine.lineNumberSeparator": {
          "type": "string",
          "default": ". ",
          "description": "Separator inserted between the line number and the code (default: \". \"). Include any spaces you want, e.g. \": \" or \" | \"."
        }
      }
    },
    "commands": [
      {
        "command": "extension.copyWithActualNumberIndent1",
        "title": "Copy with Actual Line Numbers (Indent 1 Space)"
      },
      {
        "command": "extension.copyWithActualNumberIndent2",
        "title": "Copy with Actual Line Numbers (Indent 2 Spaces)"
      },
      {
        "command": "extension.copyWithActualNumberIndent4",
        "title": "Copy with Actual Line Numbers (Indent 4 Spaces)"
      },
      {
        "command": "extension.copyWithStartingOneIndent1",
        "title": "Copy with Restart Line Numbers (Indent 1 Space)"
      },
      {
        "command": "extension.copyWithStartingOneIndent2",
        "title": "Copy with Restart Line Numbers (Indent 2 Spaces)"
      },
      {
        "command": "extension.copyWithStartingOneIndent4",
        "title": "Copy with Restart Line Numbers (Indent 4 Spaces)"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "icon": "images/COPYCODE.png",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.97.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.19.0"
  },
  "dependencies": {
    "clipboardy": "^4.0.0"
  }
}
